server {
	client_max_body_size 20M;

	# HTTPS only; nothing listens on port 80.
	listen 443 ssl default_server;
	listen [::]:443 ssl default_server;

	ssl_certificate /var/www/cert/server.cer;
	ssl_certificate_key /var/www/cert/server.key;
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_session_cache shared:osm_ssl:10m;
	ssl_session_timeout 1d;

	# `make cert` creates a self signed cert here if none exists. To create one by hand:
	#mkdir -p /var/www/cert
	#openssl req -x509 -newkey rsa:4096 -sha256 -days 3650 -nodes -keyout /var/www/cert/server.key -out /var/www/cert/server.cer -subj "/CN=osm.example.com" -addext "subjectAltName=DNS:osm.example.com,DNS:osm"

	root /var/www/osm/php/public;

	index index.php;

	server_name _;

	location = /upload.php {
		try_files $uri /index.php?upload_legacy;
	}

	location / {
		# First attempt to serve request as file, then
		# as directory, then fall back to displaying a 404.
		try_files $uri $uri/ =404;
	}

	# pass PHP scripts to FastCGI server

	location ~ \.php$ {
		include snippets/fastcgi-php.conf;
		fastcgi_param OSM_DATA_DIR "/var/www/osm-data/";
		#fastcgi_param OSM_SHOW_ERRORS "true";
		fastcgi_param PHP_VALUE "post_max_size=256M;\nupload_max_filesize=256M;\nmax_execution_time=300;";
		fastcgi_pass unix:/run/php/php8.4-fpm.sock;
		fastcgi_read_timeout 300;
	}
}
